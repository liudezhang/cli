{
  "name": "sgys-cli",
  "version": "2.0.0",
  "description": "一款可以提高开发效率的脚手架",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --ext .ts . --fix && prettier --write .",
    "clear": "rimraf bin",
    "build": "npm run clear && tsc && tsc-alias && npm run copyProfile",
    "watch": "npm run build && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "release": "ts-node scripts/release.ts",
    "copyProfile": "ts-node scripts/copyProfile.ts"
  },
  "bin": {
    "sg": "/bin/src/index.js"
  },
  "keywords": [
    "cli"
  ],
  "files": [
    "bin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "author": "ldz",
  "license": "",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gitignore-parser": "^0.0.3",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "3.2.5",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "commitizen": "^4.3.0",
    "czg": "^1.9.2",
    "fs-extra": "^11.2.0",
    "gitignore-parser": "^0.0.2",
    "inquirer": "^8.2.6",
    "lodash-es": "^4.17.21",
    "node-fetch": "2",
    "ora": "^5.4.1"
  }
}
